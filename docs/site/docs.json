  "colors": {
    "primary": "#2563eb",
    "light": "#2563eb",
    "dark": "#60a5fa"
  },
  "background": {
    "color": { "light": "#ffffff", "dark": "#181818" }
  },
  "fonts": { "family": "Geist" },
  "favicon": "/images/jas.svg",
  "navigation": {
    "groups": [
      { "group": "Start", "pages": ["index", "quickstart"] },
