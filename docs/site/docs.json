        "pages": [
          "guides/experiments",
          "guides/runs-and-evidence",
          "guides/providers-and-costs",
          "guides/publishing"
        ]
      },
      { "group": "Reference", "pages": ["reference/cli", "integrations/jas-mcp"] }
    ]
  },
  "navbar": {
    "links": [{ "label": "GitHub", "href": "https://github.com/jaiamin/jas" }]
