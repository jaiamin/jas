;; Independently scripted DEVELOPMENT Sol artifact, not production/catalog code.
;; Exhaustive external table in test_extension_generation.py predates this artifact.
(module
  (func (export "step") (param $x i32) (result i32)
    (local $s i32) (local $c i32) (local $actor i32) (local $op i32)
    (if (i32.ge_u (local.get $x) (i32.const 120)) (then (return (i32.const -1))))
    (local.set $s (i32.div_u (local.get $x) (i32.const 30)))
    (local.set $c (i32.div_u (i32.rem_u (local.get $x) (i32.const 30)) (i32.const 10)))
    (local.set $actor (i32.rem_u (i32.div_u (local.get $x) (i32.const 5)) (i32.const 2)))
    (local.set $op (i32.rem_u (local.get $x) (i32.const 5)))
    (if (i32.or (i32.eqz (local.get $c)) (i32.ge_u (local.get $s) (i32.const 2)))
      (then (return (i32.const -1))))
    (if (i32.and (i32.eq (local.get $s) (i32.const 1)) (i32.eq (local.get $c) (i32.const 2)))
      (then (return (i32.const -1))))
    (if (i32.and (i32.eqz (local.get $op))
          (i32.and (i32.eqz (local.get $s)) (i32.eqz (local.get $actor))))
      (then (return (i32.add (local.get $c) (i32.const 2)))))
    (if (i32.and (i32.eq (local.get $op) (i32.const 1))
          (i32.and (i32.eq (local.get $s) (i32.const 1)) (i32.eq (local.get $actor) (i32.const 1))))
      (then (return (i32.add (local.get $c) (i32.const 5)))))
    (if (i32.and (i32.eq (local.get $op) (i32.const 2))
          (i32.and (i32.eq (local.get $s) (i32.const 1)) (i32.eqz (local.get $actor))))
      (then (return (i32.add (local.get $c) (i32.const 1)))))
    (if (i32.eq (local.get $op) (i32.const 3))
      (then (return (i32.add (i32.mul (local.get $s) (i32.const 3)) (local.get $c)))))
    (if (i32.eq (local.get $op) (i32.const 4))
      (then (return (i32.add (i32.const 9) (local.get $c)))))
    (i32.const -1)))
