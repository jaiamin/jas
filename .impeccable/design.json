  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Standard compact source Button variant.",
      "html": "<button class=\"ds-button-primary\">New experiment</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 12px;border:0;border-radius:var(--radius-md);font-family:var(--font-sans);font-size:13px;font-weight:500;line-height:1.5;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);background:var(--primary);color:var(--primary-foreground)}.ds-button-primary:hover{background:color-mix(in srgb,var(--primary) 90%,transparent)}.ds-button-primary:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring) 50%,transparent)}.ds-button-primary:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Standard compact source Button variant.",
      "html": "<button class=\"ds-button-outline\">Configure manually</button>",
      "css": ".ds-button-outline{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 12px;border:0;border-radius:var(--radius-md);font-family:var(--font-sans);font-size:13px;font-weight:500;line-height:1.5;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);border:1px solid var(--input);background:var(--background);color:var(--foreground)}.ds-button-outline:hover{background:var(--accent);color:var(--accent-foreground)}.ds-button-outline:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring) 50%,transparent)}.ds-button-outline:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Standard compact source Button variant.",
      "html": "<button class=\"ds-button-ghost\">View all</button>",
      "css": ".ds-button-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 12px;border:0;border-radius:var(--radius-md);font-family:var(--font-sans);font-size:13px;font-weight:500;line-height:1.5;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);background:transparent;color:var(--foreground)}.ds-button-ghost:hover{background:var(--accent);color:var(--accent-foreground)}.ds-button-ghost:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring) 50%,transparent)}.ds-button-ghost:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Destructive Button",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "Standard compact source Button variant.",
      "html": "<button class=\"ds-button-destructive\">Delete draft</button>",
      "css": ".ds-button-destructive{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 12px;border:0;border-radius:var(--radius-md);font-family:var(--font-sans);font-size:13px;font-weight:500;line-height:1.5;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);background:var(--destructive);color:#fff}.ds-button-destructive:hover{background:color-mix(in srgb,var(--destructive) 90%,transparent)}.ds-button-destructive:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring) 50%,transparent)}.ds-button-destructive:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Neutral field with shared focus feedback.",
      "html": "<input class=\"ds-input\" aria-label=\"Experiment title\" placeholder=\"Experiment title\">",
      "css": ".ds-input{height:32px;max-width:100%;padding:4px 12px;border:1px solid var(--input);border-radius:var(--radius-md);background:transparent;color:var(--foreground);font-family:var(--font-sans);font-size:13px;line-height:1.5;transition:color 150ms,box-shadow 150ms}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring) 50%,transparent)}.ds-input:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Active Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Selected route with a restrained orange icon.",
      "html": "<nav aria-label=\"Main navigation\"><a class=\"ds-nav\" href=\"#experiments\" aria-current=\"page\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m12 3 10 5-10 5L2 8z\"/><path d=\"m2 12 10 5 10-5M2 16l10 5 10-5\"/></svg><span>Experiments</span></a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:8px;height:32px;padding:0 8px;border-radius:var(--radius-md);background:var(--accent);color:var(--foreground);font-family:var(--font-sans);font-size:13px;font-weight:500;line-height:1.5;text-decoration:none}.ds-nav svg{color:var(--brand)}.ds-nav:hover,.ds-nav:active{background:var(--accent)}.ds-nav:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Context Badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Non-interactive secondary context tag.",
      "html": "<span class=\"ds-badge\">Recorded</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;padding:2px 8px;border:1px solid transparent;border-radius:var(--radius-sm);background:var(--muted);color:var(--foreground);font-family:var(--font-sans);font-size:12px;font-weight:500;line-height:16px;white-space:nowrap}"
    },
    {
      "name": "Execution Summary",
      "kind": "card",
      "refersTo": "execution-summary",
      "description": "Flat tonal summary beside the editor.",
      "html": "<aside class=\"ds-summary\"><h2>Execution summary</h2><dl><div><dt>Agents</dt><dd>4</dd></div><div><dt>Turns</dt><dd>20</dd></div></dl></aside>",
      "css": ".ds-summary{padding:20px;border-radius:var(--radius);background:var(--sidebar);color:var(--foreground);font-family:var(--font-sans);font-size:12px;line-height:1.5}.ds-summary h2{margin:0 0 17px;font-size:14px;font-weight:600;letter-spacing:-.15px}.ds-summary dl{margin:0}.ds-summary dl>div{display:flex;justify-content:space-between;gap:12px;margin-bottom:11px}.ds-summary dt{color:var(--muted-foreground)}.ds-summary dd{margin:0;font-weight:500;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Question Composer",
      "kind": "custom",
      "refersTo": "question-composer",
      "description": "Input group with unframed textarea and footer action.",
      "html": "<div class=\"ds-composer\"><textarea class=\"ds-composer-text\" aria-label=\"Your research question\" placeholder=\"What would you like to explore?\"></textarea><div class=\"ds-composer-footer\"><span>Design with AI, then review before running.</span><button class=\"ds-composer-action\">Design experiment</button></div></div>",
      "css": ".ds-composer{border:1px solid var(--input);border-radius:var(--radius-md);color:var(--foreground);font-family:var(--font-sans);transition:color 150ms,box-shadow 150ms}.ds-composer:focus-within{outline:none;border-color:var(--ring);box-shadow:none}.ds-composer-text{display:block;width:100%;min-height:84px;padding:16px 16px 8px;border:0;border-radius:0;background:transparent;color:var(--foreground);font:15px/1.5 var(--font-sans);resize:vertical;outline:none}.ds-composer-text::placeholder{color:var(--muted-foreground)}.ds-composer-footer{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:6px 12px 12px}.ds-composer-footer>span{color:var(--muted-foreground);font-size:12px;line-height:1.5}.ds-composer-action{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 12px;border:0;border-radius:var(--radius-md);font-family:var(--font-sans);font-size:13px;font-weight:500;line-height:1.5;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1);background:var(--primary);color:var(--primary-foreground)}.ds-composer-action:hover{background:color-mix(in srgb,var(--primary) 90%,transparent)}.ds-composer-action:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring) 50%,transparent)}"
    },
    {
      "name": "Task Tabs",
      "kind": "nav",
      "refersTo": "tabs",
      "description": "Segmented tabs for editor tasks and run views.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Experiment design\"><button role=\"tab\" aria-selected=\"true\" class=\"ds-tab\">Question</button><button role=\"tab\" aria-selected=\"false\" class=\"ds-tab\">Agents</button><button role=\"tab\" aria-selected=\"false\" class=\"ds-tab\">Conditions</button></div>",
      "css": ".ds-tabs{display:inline-flex;align-items:center;height:36px;padding:3px;border-radius:var(--radius-lg);background:var(--muted);color:var(--muted-foreground)}.ds-tab{height:calc(100% - 1px);padding:4px 8px;border:1px solid transparent;border-radius:var(--radius-md);background:transparent;color:color-mix(in srgb,var(--foreground) 60%,transparent);font:500 13px/1.5 var(--font-sans);cursor:pointer;transition:all 150ms}.ds-tab[aria-selected=true]{background:var(--background);color:var(--foreground);box-shadow:0 1px 3px 0 rgb(0 0 0 / .1),0 1px 2px -1px rgb(0 0 0 / .1)}.ds-tab:hover{color:var(--foreground)}.ds-tab:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring) 50%,transparent)}"
    }
  ],
  "narrative": {
