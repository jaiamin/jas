      "css": ".ds-button-primary{font:500 13px/1.715 Roboto,sans-serif;letter-spacing:0;border-radius:var(--radius,6px);min-height:36px;padding:4px 16px;cursor:pointer;position:relative;padding:4px 15px;background:var(--accent, #85b8d2);color:var(--action-ink, #101b23);border:0;}.ds-button-primary::after{content:\"\";position:absolute;inset:0;border-radius:inherit;background:currentColor;opacity:0;pointer-events:none;}.ds-button-primary:hover:not(:disabled)::after{opacity:.15;}.ds-button-primary:focus-visible{outline:2px solid var(--accent, #85b8d2);outline-offset:3px;}.ds-button-primary:disabled{opacity:.45;cursor:default;}"
