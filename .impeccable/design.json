  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared sentence-case action with the primary treatment.",
      "html": "<button type=\"button\" class=\"ds-button\">Create experiment</button>",
      "css": ".ds-button { display:inline-flex; align-items:center; justify-content:center; gap:7px; height:36px; padding:0 13px; border:1px solid transparent; border-radius:6px; font-family:var(--font-sans); font-size:12px; line-height:1.3; font-weight:550; white-space:nowrap; cursor:pointer; transition:background-color .14s,border-color .14s; } .ds-button:focus-visible { outline:2px solid var(--ring); outline-offset:3px; }.ds-button { background:var(--primary); color:var(--primary-foreground); border-color:var(--primary); } .ds-button:hover { filter:brightness(.95); color:var(--primary-foreground); } .ds-button:disabled { opacity:.48; cursor:not-allowed; filter:none; }"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Shared sentence-case action with the outline treatment.",
      "html": "<button type=\"button\" class=\"ds-button\">Compare runs</button>",
      "css": ".ds-button { display:inline-flex; align-items:center; justify-content:center; gap:7px; height:36px; padding:0 13px; border:1px solid transparent; border-radius:6px; font-family:var(--font-sans); font-size:12px; line-height:1.3; font-weight:550; white-space:nowrap; cursor:pointer; transition:background-color .14s,border-color .14s; } .ds-button:focus-visible { outline:2px solid var(--ring); outline-offset:3px; }.ds-button { background:var(--background); color:var(--foreground); border-color:var(--input); } .ds-button:hover { background:var(--muted); color:var(--foreground); } .ds-button:disabled { opacity:.48; cursor:not-allowed; filter:none; }"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Shared sentence-case action with the ghost treatment.",
      "html": "<button type=\"button\" class=\"ds-button\">Cancel</button>",
      "css": ".ds-button { display:inline-flex; align-items:center; justify-content:center; gap:7px; height:36px; padding:0 13px; border:1px solid transparent; border-radius:6px; font-family:var(--font-sans); font-size:12px; line-height:1.3; font-weight:550; white-space:nowrap; cursor:pointer; transition:background-color .14s,border-color .14s; } .ds-button:focus-visible { outline:2px solid var(--ring); outline-offset:3px; }.ds-button { background:transparent; color:var(--muted-foreground); } .ds-button:hover { background:var(--muted); color:var(--foreground); } .ds-button:disabled { opacity:.48; cursor:not-allowed; filter:none; }"
    },
    {
      "name": "Destructive Button",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "Shared sentence-case action with the destructive treatment.",
      "html": "<button type=\"button\" class=\"ds-button\">Stop run</button>",
      "css": ".ds-button { display:inline-flex; align-items:center; justify-content:center; gap:7px; height:36px; padding:0 13px; border:1px solid transparent; border-radius:6px; font-family:var(--font-sans); font-size:12px; line-height:1.3; font-weight:550; white-space:nowrap; cursor:pointer; transition:background-color .14s,border-color .14s; } .ds-button:focus-visible { outline:2px solid var(--ring); outline-offset:3px; }.ds-button { color:var(--destructive); background:var(--danger-background); } .ds-button:disabled { opacity:.48; cursor:not-allowed; filter:none; }"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Outlined field with a quiet label and clear focus.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Experiment name</span><input class=\"ds-input\" placeholder=\"Name your experiment\"></label>",
      "css": ".ds-field { display:flex; flex-direction:column; gap:7px; font-family:var(--font-sans); } .ds-field-label { color:var(--foreground); font-size:12px; line-height:1.6; font-weight:550; } .ds-input { box-sizing:border-box; background:var(--background); color:var(--foreground); border:1px solid var(--input); border-radius:6px; min-height:36px; padding:7px 10px; font-family:var(--font-sans); font-size:13px; line-height:20px; caret-color:var(--primary); } .ds-input::placeholder { color:var(--muted-foreground); opacity:1; } .ds-input:focus,.ds-input:focus-visible { outline:2px solid var(--ring); outline-offset:1px; } .ds-input:disabled { opacity:.5; } @media(max-width:600px) { .ds-input { font-size:16px; } }"
    },
    {
      "name": "Main Navigation",
      "kind": "nav",
      "refersTo": "navigation-selected",
      "description": "A selected route in the restrained orange navigation rail.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a class=\"ds-nav-link\" href=\"#\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"/><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg><span>Home</span></a></nav>",
      "css": ".ds-nav { padding:12px; background:var(--sidebar); border:1px solid var(--sidebar-border); } .ds-nav-link { display:flex; align-items:center; gap:10px; height:37px; padding:0 11px; border-radius:5px; font-family:var(--font-sans); font-size:12px; line-height:1.6; color:var(--muted-foreground); text-decoration:none; } .ds-nav-link svg { width:16px; height:16px; } .ds-nav-link:hover { background:var(--muted); color:var(--foreground); } .ds-nav-link[aria-current=\"page\"],.ds-nav-link[aria-current=\"page\"]:hover { background:var(--accent); color:var(--accent-foreground); font-weight:550; } .ds-nav-link:focus-visible { outline:2px solid var(--ring); outline-offset:3px; }"
    },
    {
      "name": "Context Badge & Status",
      "kind": "chip",
      "refersTo": "badge",
      "description": "A quiet context badge beside an explicit labeled status.",
      "html": "<div class=\"ds-badges\"><span class=\"ds-badge\">Saved input &amp; output</span><span class=\"ds-status\"><span class=\"ds-dot\" aria-hidden=\"true\"></span>Complete</span></div>",
      "css": ".ds-badges { display:flex; align-items:center; gap:16px; font-family:var(--font-sans); line-height:1.6; } .ds-badge { display:inline-flex; align-items:center; gap:6px; padding:2px 7px; border-radius:4px; background:var(--muted); color:var(--muted-foreground); font-size:11px; font-weight:450; white-space:nowrap; } .ds-status { display:inline-flex; align-items:center; gap:6px; color:var(--success); font-size:12px; } .ds-dot { display:inline-block; width:6px; height:6px; border-radius:50%; background:var(--success); }"
    },
    {
      "name": "Condition Container",
      "kind": "card",
      "refersTo": "condition-container",
      "description": "A condition’s bordered name/index and editable parameter pattern.",
      "html": "<section class=\"ds-condition\"><div class=\"ds-condition-heading\"><span class=\"ds-condition-index\">A</span><input class=\"ds-condition-input\" aria-label=\"Condition 1 name\" value=\"More resources\"></div><label class=\"ds-condition-field\"><span class=\"ds-condition-label\">Credits per round</span><input class=\"ds-condition-input\" type=\"number\" min=\"2\" max=\"100\" value=\"20\"></label></section>",
      "css": ".ds-condition { border:1px solid var(--border); border-radius:6px; padding:16px; background:var(--background); color:var(--foreground); font-family:var(--font-sans); } .ds-condition-heading { display:flex; align-items:center; gap:9px; margin-bottom:18px; } .ds-condition-index { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; background:var(--series-0-background); color:var(--foreground); border-radius:4px; font-size:12px; line-height:1.6; font-weight:600; } .ds-condition-input { box-sizing:border-box; min-width:0; width:100%; min-height:36px; padding:7px 10px; border:1px solid var(--input); border-radius:6px; color:var(--foreground); background:var(--background); font-family:var(--font-sans); font-size:13px; line-height:20px; caret-color:var(--primary); } .ds-condition-input:focus,.ds-condition-input:focus-visible { outline:2px solid var(--ring); outline-offset:1px; } .ds-condition-input:disabled { opacity:.5; } .ds-condition-field { display:flex; flex-direction:column; gap:7px; } .ds-condition-label { font-size:12px; line-height:1.6; font-weight:550; } @media(max-width:600px) { .ds-condition { padding:13px; } .ds-condition-input { font-size:16px; } }"
    },
    {
      "name": "Record Table",
      "kind": "custom",
      "refersTo": "table",
      "description": "One flat, scrollable record frame with aligned numbers and a selected row.",
      "html": "<div class=\"ds-table-frame\"><div class=\"ds-table-scroll\"><table class=\"ds-table\"><thead><tr><th>Turn</th><th>Agent</th><th>Decision</th></tr></thead><tbody><tr data-selected=\"true\"><td><button class=\"ds-record\" type=\"button\">60</button></td><td>Morgan</td><td>Contribute 0</td></tr><tr><td><button class=\"ds-record\" type=\"button\">59</button></td><td>Sam</td><td>Contribute 0</td></tr></tbody></table></div></div>",
      "css": ".ds-table-frame { border:1px solid var(--border); border-radius:6px; overflow:hidden; background:var(--background); } .ds-table-scroll { overflow-x:auto; } .ds-table { width:100%; border-collapse:collapse; text-align:left; color:var(--foreground); font-family:var(--font-sans); font-size:12px; line-height:1.6; font-variant-numeric:tabular-nums; } .ds-table th { background:var(--muted); color:var(--muted-foreground); font-size:11px; font-weight:500; padding:10px 15px; border-bottom:1px solid var(--border); white-space:nowrap; } .ds-table td { padding:12px 15px; border-bottom:1px solid var(--border); vertical-align:top; } .ds-table tr:last-child td { border-bottom:0; } .ds-table tbody tr:hover,.ds-table tr[data-selected=\"true\"] { background:color-mix(in srgb,var(--accent) 50%,var(--background)); } .ds-record { padding:0; border:0; background:transparent; color:var(--primary); font-family:var(--font-sans); font-size:11px; text-align:left; cursor:pointer; } .ds-record:hover { text-decoration:underline; } .ds-record:focus-visible { outline:2px solid var(--ring); outline-offset:3px; } @media(max-width:600px) { .ds-table th { padding:9px 12px; } .ds-table td { padding:11px 12px; } }"
    },
    {
      "name": "Linked Turn Rail",
      "kind": "custom",
      "refersTo": "turn-rail",
      "description": "A continuous turn selector with step controls and a return to Latest.",
      "html": "<div class=\"ds-turn-rail\"><span class=\"ds-turn-label\"><span class=\"ds-turn-dot\" aria-hidden=\"true\"></span>Viewing turn 60</span><div class=\"ds-scrubber\"><button class=\"ds-step\" type=\"button\" aria-label=\"Previous turn\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"/></svg></button><input type=\"range\" min=\"0\" max=\"120\" value=\"60\" aria-label=\"Recorded turn\"><button class=\"ds-step\" type=\"button\" aria-label=\"Next turn\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></button></div><button class=\"ds-latest\" type=\"button\">Latest</button></div>",
      "css": ".ds-turn-rail { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:24px; padding:12px 0; color:var(--foreground); font-family:var(--font-sans); } .ds-turn-label { display:flex; align-items:center; gap:8px; min-width:120px; font-size:11px; line-height:1.6; font-variant-numeric:tabular-nums; } .ds-turn-dot { width:6px; height:6px; border-radius:50%; background:var(--muted-foreground); } .ds-scrubber { display:flex; align-items:center; gap:8px; min-width:0; } .ds-scrubber input { flex:1; width:100%; min-width:80px; accent-color:var(--primary); cursor:pointer; } .ds-step { display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; padding:0; border:1px solid transparent; border-radius:6px; background:transparent; color:var(--muted-foreground); cursor:pointer; } .ds-step svg { width:15px; height:15px; } .ds-step:hover { background:var(--muted); color:var(--foreground); } .ds-latest { height:30px; padding:0 10px; border:1px solid var(--input); border-radius:6px; color:var(--foreground); background:var(--background); font-family:var(--font-sans); font-size:12px; line-height:1.3; font-weight:550; cursor:pointer; transition:background-color .14s,border-color .14s; } .ds-latest:hover { background:var(--muted); } .ds-step:focus-visible,.ds-latest:focus-visible,.ds-scrubber input:focus-visible { outline:2px solid var(--ring); outline-offset:3px; } @media(max-width:600px) { .ds-turn-rail { grid-template-columns:1fr auto; gap:7px; padding:12px 0 7px; } .ds-scrubber { grid-row:2; grid-column:1/-1; gap:5px; } }"
    }
  ],
  "narrative": {
    "northStar": "The University Research Service",
    "overview": "The University Research Service gives experimental work a calm, practical home. Neutral white and charcoal work surfaces, restrained orange selection and fine rules support compact records without making every section a card. Light and dark themes preserve the same hierarchy.\n\nPublic Sans carries the interface. Clear labels, aligned numbers and progressively disclosed evidence keep experiments understandable. Charts and environment diagrams are data views; their colors distinguish series and agents without judging them.",
    "keyCharacteristics": [
      "Neutral white and charcoal surfaces with orange action and selection.",
      "Compact tables and continuous ruled work areas.",
      "Public Sans with restrained weight and size changes.",
      "A linked turn rail and recorded-evidence inspector.",
      "Responsive layouts with direct mobile inspection."
    ],
    "rules": [
      {
        "name": "The Orange Accent Rule",
        "body": "Orange marks action and selection. Keep work surfaces neutral and keep green out of brand, status and data colors.",
        "section": "colors"
      },
      {
        "name": "The Role Parity Rule",
        "body": "Replace theme roles together; preserve the same selection, reading and status hierarchy.",
        "section": "colors"
      },
      {
        "name": "The Series Identity Rule",
        "body": "Data colors distinguish agents or histories. They do not imply moral rank, quality or success.",
        "section": "colors"
      },
      {
        "name": "The Quiet Structure Rule",
        "body": "Use spacing, tonal surfaces and thin rules for ordinary structure. Reserve soft shadows for the question composer and select menu.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Public Sans, shared theme roles and compact control sizes.",
      "Do preserve aligned columns, tabular numbers and contained table scrolling.",
      "Do keep decision turns, typed actions and recorded evidence visibly connected.",
      "Do preserve visible focus and the direct mobile path between decisions and evidence.",
      "Do accompany status colors and dots with explicit labels."
    ],
    "donts": [
      "Don't introduce green brand, status or data colors.",
      "Don't turn every section, metric or evidence disclosure into another raised card.",
      "Don't use series colors as judgments about agents or outcomes.",
      "Don't replace readable labels with icon-only status or add a competing display face.",
      "Don't extend charts beyond recorded points or conceal historical failures with decorative success treatments."
    ]
  }
}
