      "description": "Selected and idle destinations; inline SVG replaces the shipped icon-font dependency in this specimen.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><button class=\"ds-nav-item ds-nav-selected\" aria-current=\"page\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M3 5h4v4H3V5zm6 0h12v4H9V5zm-6 5h4v4H3v-4zm6 0h12v4H9v-4zm-6 5h4v4H3v-4zm6 0h12v4H9v-4z\"/></svg>Runs</button><button class=\"ds-nav-item\">Environments</button></nav>",
      "css": ".ds-nav{display:grid;gap:5px;background:var(--sidebar, #171e25);padding:16px;max-width:196px;}.ds-nav-item{font:500 13px/1.715 Roboto,sans-serif;letter-spacing:0;border-radius:var(--radius,6px);min-height:36px;padding:4px 16px;cursor:pointer;position:relative;display:flex;align-items:center;gap:10px;min-height:40px;padding:0 12px;background:transparent;color:var(--nav-ink, #bdc8d4);border:0;text-align:left;}.ds-nav-selected{background:var(--nav-selected, #273948);color:var(--nav-selected-ink, #d1e4ef);}.ds-nav-item::after{content:\"\";position:absolute;inset:0;border-radius:inherit;background:currentColor;opacity:0;pointer-events:none;}.ds-nav-item:hover::after{opacity:.15;}.ds-nav-item:focus-visible{outline:2px solid var(--accent, #85b8d2);outline-offset:3px;}"
    },
    {
      "name": "Labeled status",
      "kind": "chip",
      "refersTo": "status",
      "description": "Non-interactive status tags pair a semantic dot with explicit state text; no decorative pill.",
      "html": "<div class=\"ds-statuses\"><span class=\"ds-status ds-status-complete\">Complete</span><span class=\"ds-status ds-status-running\">Running</span><span class=\"ds-status ds-status-paused\">Paused</span><span class=\"ds-status ds-status-failed\">Failed</span></div>",
      "css": ".ds-statuses{display:flex;flex-wrap:wrap;gap:18px;color:var(--ink, #e7e9ed);}.ds-status{display:inline-flex;align-items:center;gap:7px;white-space:nowrap;font:12px/1.55 Roboto,sans-serif;}.ds-status::before{content:\"\";width:6px;height:6px;border-radius:50%;background:var(--status-neutral, #a6b2c0);}.ds-status-complete::before{background:var(--success, #8ebca7);}.ds-status-running::before{background:var(--accent, #85b8d2);}.ds-status-paused::before{background:var(--warning, #d6b57b);}.ds-status-failed::before{background:var(--danger, #e0a09b);}"
    },
    {
      "name": "Run table",
      "kind": "custom",
      "refersTo": "table",
      "description": "A continuous frame with muted headings, aligned values and an interactive run label; hover and keyboard focus remain visible.",
      "html": "<div class=\"ds-table-frame\"><table class=\"ds-table\"><thead><tr><th>Run</th><th>Status</th><th>Turns</th></tr></thead><tbody><tr><td><button class=\"ds-run-link\">Colony baseline</button><span class=\"ds-table-note\">GPT-6 Luna · Seed 42</span></td><td>Complete</td><td class=\"ds-table-number\">24 / 24</td></tr></tbody></table></div>",
      "css": ".ds-table-frame{border:1px solid var(--line, #303740);border-radius:var(--radius,6px);overflow:auto;}.ds-table{border-collapse:collapse;width:100%;color:var(--ink, #e7e9ed);font:13px/1.55 Roboto,sans-serif;}.ds-table th{height:43px;padding:0 16px;text-align:left;background:var(--surface, #171b20);color:var(--muted, #adb5c0);font-size:12px;font-weight:500;white-space:nowrap;}.ds-table td{height:61px;padding:14px 16px;border-top:1px solid var(--line, #303740);}.ds-table tbody tr:hover{background:var(--row-hover, #1b222a);}.ds-run-link{border:0;padding:0;background:none;color:var(--ink, #e7e9ed);font:500 13px/1.55 Roboto,sans-serif;cursor:pointer;text-align:left;}.ds-run-link:hover{color:var(--accent, #85b8d2);text-decoration:underline;text-underline-offset:3px;}.ds-run-link:focus-visible{outline:2px solid var(--accent, #85b8d2);outline-offset:3px;}.ds-table-note{display:block;margin-top:4px;color:var(--muted, #adb5c0);font-size:11px;}.ds-table-number{font-variant-numeric:tabular-nums;white-space:nowrap;}"
    },
    {
      "name": "Facility data node",
      "kind": "card",
      "refersTo": "facility-selected",
      "description": "Actual map-node geometry and selected styling. This specimen is a data card; use the labeled facility selector for keyboard interaction in the viewer.",
      "html": "<div class=\"ds-facility-pair\"><div class=\"ds-facility\" role=\"img\" aria-label=\"Habitat, integrity 96 percent, level 1\"><span class=\"ds-facility-name\">Habitat</span><span class=\"ds-facility-detail\">96% · Level 1</span></div><div class=\"ds-facility ds-facility-selected\" role=\"img\" aria-label=\"Selected reactor, integrity 48 percent, level 1\"><span class=\"ds-facility-name\">Reactor</span><span class=\"ds-facility-detail ds-facility-warning\">48% · Level 1</span></div></div>",
      "css": ".ds-facility-pair{display:flex;flex-wrap:wrap;gap:30px;}.ds-facility{width:148px;height:78px;border:1.5px solid var(--map-line, #465462);border-radius:var(--radius,6px);background:var(--raised, #20262d);color:var(--ink, #e7e9ed);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;}.ds-facility-selected{background:var(--accent-ground, #20333f);border-color:var(--accent, #85b8d2);}.ds-facility-name{font:17px/1 sans-serif;}.ds-facility-detail{font:13px/1 sans-serif;color:var(--muted, #adb5c0);}.ds-facility-warning{color:var(--warning, #d6b57b);}"
    },
    {
      "name": "Recorded input disclosure",
      "kind": "custom",
      "refersTo": "evidence",
      "description": "Turn-labeled progressive disclosure keeps exact model input distinct from state after the selected checkpoint. Native details supplies framework-free interaction.",
      "html": "<section class=\"ds-evidence\"><p class=\"ds-evidence-label\">State after turn 8</p><p class=\"ds-evidence-body\">Location: Habitat · Stamina: 72</p><details class=\"ds-evidence-detail\"><summary>Recorded model input · turn 7</summary><p class=\"ds-evidence-description\">Exact input saved before this decision, including the agent’s then-current memory.</p><pre class=\"ds-evidence-json\">{\n  \"turn\": 7,\n  \"self\": { \"location\": \"reactor\", \"stamina\": 64 }\n}</pre></details></section>",
      "css": ".ds-evidence{color:var(--ink, #e7e9ed);font:13px/1.7 Roboto,sans-serif;max-width:70ch;}.ds-evidence-label{font-size:12px;color:var(--muted, #adb5c0);margin:0 0 8px;}.ds-evidence-body{margin:0 0 22px;}.ds-evidence-detail{border-top:1px solid var(--line, #303740);}.ds-evidence-detail summary{padding:12px 0;min-height:44px;cursor:pointer;position:relative;}.ds-evidence-detail summary::after{content:\"\";position:absolute;inset:0;background:currentColor;opacity:0;pointer-events:none;}.ds-evidence-detail summary:hover::after{opacity:.15;}.ds-evidence-detail summary:focus-visible{outline:2px solid var(--accent, #85b8d2);outline-offset:3px;}.ds-evidence-description{margin:0 0 16px;color:var(--muted, #adb5c0);font-size:13px;line-height:1.65;}.ds-evidence-json{margin:0 0 16px;padding:14px;background:var(--surface, #171b20);border-radius:var(--radius,6px);font:12px/1.6 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;max-height:360px;overflow:auto;}"
    }
  ],
  "narrative": {
    "northStar": "The Research Index",
    "overview": "The Research Index gives experiment records the clarity of a technical standards manual. Neutral ink grounds, a slate navigation rail, thin rules and aligned columns make dense evidence readable. Ice-blue selection identifies the current route or action; outcome color remains functional.\n\nUse one quiet sans family and direct labels. Prefer continuous work areas and progressively disclosed detail over repeated panels. Maps and charts represent recorded data and remain subordinate to the shared evaluation interface. This is an operating workspace: selected turns, model input, checkpoint state and replay must remain visibly distinct.",
    "keyCharacteristics": [
      "Compact, aligned information with restrained hierarchy.",
      "Flat dark surfaces with thin structural rules.",
      "Ice-blue selection and explicit semantic outcomes.",
      "Recorded evidence with clear turn and state labels.",
      "Responsive task layouts rather than scaled-down desktop views."
    ],
    "rules": [
      {
        "name": "The Functional Color Rule",
        "body": "Use the accent for navigation, selection and actions; use success, warning and danger only for meaningful status or data. Series lavender distinguishes recorded chart histories.",
        "section": "colors"
      },
      {
        "name": "The Quiet Hierarchy Rule",
        "body": "Use the page title once, section headings for work areas, and smaller muted labels for supporting metadata. Preserve tabular numerals in comparable values.",
        "section": "typography"
      },
      {
        "name": "The Flat Structure Rule",
        "body": "Separate ordinary work areas with spacing, tonal contrast and thin rules. Do not add shadows to the table, buttons or evidence panels.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared neutral palette and the locally served Roboto family for interface text.",
      "Do preserve table alignment, tabular numbers and contained horizontal scrolling for dense records.",
      "Do label a recorded decision with its own turn and label checkpoint state as state after its selected turn.",
      "Do expose saved model input separately from reconstructed post-turn observation and memory.",
      "Do retain visible focus, meaningful disabled states, empty states and recoverable error copy.",
      "Do offer a labeled selector alongside the clickable facility map."
    ],
    "donts": [
      "Don't restore the permanent map, setup and inspector arrangement as the platform shell.",
      "Don't repeat summary values across nested cards or turn supporting metadata into competing headings.",
      "Don't use semantic status color as decoration on inactive controls.",
      "Don't fabricate scores, model rankings, telemetry or chart continuation beyond recorded history.",
      "Don't introduce raster backgrounds, decorative gradients, display effects or new icon styles."
    ]
  }
}
