  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared compact primary action.",
      "html": "<button class=\"ds-button\" type=\"button\">Create experiment</button>",
      "css": ".ds-button { display:inline-flex; align-items:center; justify-content:center; gap:7px; height:36px; padding:0 13px; border:1px solid transparent; border-radius:var(--radius); font-family:var(--font-sans); font-size:13px; line-height:1.3; font-weight:500; white-space:nowrap; cursor:pointer; transition:background-color .14s,border-color .14s; } .ds-button:focus-visible { outline:2px solid var(--ring); outline-offset:3px; }.ds-button { background:var(--primary); color:var(--primary-foreground); border-color:var(--primary); } .ds-button:hover { filter:brightness(.95); color:var(--primary-foreground); } .ds-button:disabled { opacity:.48; cursor:not-allowed; filter:none; }"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Shared compact outline action.",
      "html": "<button class=\"ds-button\" type=\"button\">Configure manually</button>",
      "css": ".ds-button { display:inline-flex; align-items:center; justify-content:center; gap:7px; height:36px; padding:0 13px; border:1px solid transparent; border-radius:var(--radius); font-family:var(--font-sans); font-size:13px; line-height:1.3; font-weight:500; white-space:nowrap; cursor:pointer; transition:background-color .14s,border-color .14s; } .ds-button:focus-visible { outline:2px solid var(--ring); outline-offset:3px; }.ds-button { background:var(--background); color:var(--foreground); border-color:var(--input); } .ds-button:hover { background:var(--muted); color:var(--foreground); } .ds-button:disabled { opacity:.48; cursor:not-allowed; filter:none; }"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Shared compact ghost action.",
      "html": "<button class=\"ds-button\" type=\"button\">Cancel</button>",
      "css": ".ds-button { display:inline-flex; align-items:center; justify-content:center; gap:7px; height:36px; padding:0 13px; border:1px solid transparent; border-radius:var(--radius); font-family:var(--font-sans); font-size:13px; line-height:1.3; font-weight:500; white-space:nowrap; cursor:pointer; transition:background-color .14s,border-color .14s; } .ds-button:focus-visible { outline:2px solid var(--ring); outline-offset:3px; }.ds-button { background:transparent; color:var(--muted-foreground); } .ds-button:hover { background:var(--muted); color:var(--foreground); } .ds-button:disabled { opacity:.48; cursor:not-allowed; filter:none; }"
    },
    {
      "name": "Destructive Button",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "Shared compact destructive action.",
      "html": "<button class=\"ds-button\" type=\"button\">Stop run</button>",
      "css": ".ds-button { display:inline-flex; align-items:center; justify-content:center; gap:7px; height:36px; padding:0 13px; border:1px solid transparent; border-radius:var(--radius); font-family:var(--font-sans); font-size:13px; line-height:1.3; font-weight:500; white-space:nowrap; cursor:pointer; transition:background-color .14s,border-color .14s; } .ds-button:focus-visible { outline:2px solid var(--ring); outline-offset:3px; }.ds-button { color:var(--destructive); background:var(--danger-background); } .ds-button:disabled { opacity:.48; cursor:not-allowed; filter:none; }"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "A sharp outlined field with a visible label and neutral focus.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Experiment name</span><input class=\"ds-input\" placeholder=\"Name your experiment\"></label>",
      "css": ".ds-field { display:flex; flex-direction:column; gap:7px; font-family:var(--font-sans); } .ds-field-label { color:var(--foreground); font-size:13px; line-height:1.6; font-weight:500; } .ds-input { box-sizing:border-box; min-height:36px; padding:7px 10px; background:var(--background); color:var(--foreground); border:1px solid var(--input); border-radius:var(--radius); font-family:var(--font-sans); font-size:13px; line-height:20px; caret-color:var(--primary); } .ds-input::placeholder { color:var(--muted-foreground); opacity:1; } .ds-input:focus,.ds-input:focus-visible { outline:2px solid var(--ring); outline-offset:1px; } .ds-input:disabled { opacity:.5; } @media(max-width:600px) { .ds-input { font-size:16px; } }"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "navigation-selected",
      "description": "Neutral route selection with a small orange active icon.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a class=\"ds-nav-link\" href=\"#\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"/><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg><span>Home</span></a></nav>",
      "css": ".ds-nav { padding:16px 10px; background:var(--sidebar); border-right:1px solid var(--sidebar-border); } .ds-nav-link { display:flex; align-items:center; gap:10px; height:34px; padding:0 10px; border-radius:var(--radius); color:var(--muted-foreground); font-family:var(--font-sans); font-size:13px; line-height:1.6; text-decoration:none; } .ds-nav-link svg { width:16px; height:16px; } .ds-nav-link:hover { background:var(--muted); color:var(--foreground); } .ds-nav-link[aria-current=\"page\"],.ds-nav-link[aria-current=\"page\"]:hover { background:var(--accent); color:var(--accent-foreground); font-weight:500; } .ds-nav-link[aria-current=\"page\"] > svg { color:var(--brand); } .ds-nav-link:focus-visible { outline:2px solid var(--ring); outline-offset:3px; }"
    },
    {
      "name": "Context Badge & Status",
      "kind": "chip",
      "refersTo": "badge",
      "description": "A neutral context badge beside an explicit completion label.",
      "html": "<div class=\"ds-tags\"><span class=\"ds-badge\">Saved input &amp; output</span><span class=\"ds-status\"><span class=\"ds-dot\" aria-hidden=\"true\"></span>Complete</span></div>",
      "css": ".ds-tags { display:flex; align-items:center; gap:16px; font-family:var(--font-sans); line-height:1.6; } .ds-badge { display:inline-flex; align-items:center; gap:6px; padding:2px 7px; border-radius:var(--radius-sm); background:var(--muted); color:var(--muted-foreground); font-size:12px; font-weight:450; white-space:nowrap; } .ds-status { display:inline-flex; align-items:center; gap:6px; color:var(--success); font-size:13px; font-weight:450; } .ds-dot { display:inline-block; width:6px; height:6px; border-radius:50%; background:var(--success); }"
    },
    {
      "name": "Execution Summary",
      "kind": "card",
      "refersTo": "execution-summary",
      "description": "A flat, lightly toned summary beside the progressive editor.",
      "html": "<aside class=\"ds-summary\"><h2>Execution plan</h2><dl><div><dt>Agents per run</dt><dd>4</dd></div><div><dt>Conditions</dt><dd>2</dd></div><div><dt>Independent runs</dt><dd>6</dd></div></dl></aside>",
      "css": ".ds-summary { padding:20px; border:1px solid var(--sidebar-border); border-radius:var(--radius); color:var(--foreground); background:var(--sidebar); font-family:var(--font-sans); } .ds-summary h2 { margin:0 0 17px; font-size:15px; line-height:1.5; font-weight:600; letter-spacing:-.15px; } .ds-summary dl { margin:0 0 18px; } .ds-summary dl > div { display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:11px; font-size:12px; line-height:1.6; } .ds-summary dt { color:var(--muted-foreground); } .ds-summary dd { margin:0; font-weight:500; text-align:right; font-variant-numeric:tabular-nums; } @media(max-width:600px) { .ds-summary { padding:16px; } }"
    },
    {
      "name": "Record Table",
      "kind": "custom",
      "refersTo": "table",
      "description": "A flat record frame with compact headers and a neutral selected row.",
      "html": "<div class=\"ds-table-frame\"><div class=\"ds-table-scroll\"><table class=\"ds-table\"><thead><tr><th>Turn</th><th>Agent</th><th>Decision</th></tr></thead><tbody><tr data-selected=\"true\"><td><button class=\"ds-turn\" type=\"button\">60</button></td><td>Morgan</td><td>Contribute 0</td></tr><tr><td><button class=\"ds-turn\" type=\"button\">59</button></td><td>Sam</td><td>Contribute 0</td></tr></tbody></table></div></div>",
      "css": ".ds-table-frame { border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; background:var(--background); } .ds-table-scroll { overflow-x:auto; } .ds-table { width:100%; border-collapse:collapse; text-align:left; color:var(--foreground); font-family:var(--font-sans); font-size:13px; line-height:1.6; font-variant-numeric:tabular-nums; } .ds-table th { padding:10px 15px; border-bottom:1px solid var(--border); background:var(--muted); color:var(--muted-foreground); font-size:12px; font-weight:500; white-space:nowrap; } .ds-table td { padding:12px 15px; border-bottom:1px solid var(--border); vertical-align:top; } .ds-table tbody tr:last-child td { border-bottom:0; } .ds-table tbody tr:hover,.ds-table tr[data-selected=\"true\"] { background:color-mix(in srgb,var(--accent) 50%,var(--background)); } .ds-turn { padding:0; border:0; color:var(--primary); background:transparent; font-family:var(--font-sans); font-size:12px; text-align:left; cursor:pointer; } .ds-turn:hover { text-decoration:underline; } .ds-turn:focus-visible { outline:2px solid var(--ring); outline-offset:3px; } @media(max-width:600px) { .ds-table th { padding:9px 12px; } .ds-table td { padding:11px 12px; } }"
    },
    {
      "name": "Question Input Group",
      "kind": "custom",
      "refersTo": "question-composer",
      "description": "One sharp question field with a supporting footer and monochrome action.",
      "html": "<div class=\"ds-composer\"><textarea class=\"ds-question\" aria-label=\"Research question\" placeholder=\"When do agents choose themselves over the group?\"></textarea><div class=\"ds-composer-addon\"><span>Review the AI draft before running.</span><button class=\"ds-button\" type=\"button\">Design experiment</button></div></div>",
      "css": ".ds-button { display:inline-flex; align-items:center; justify-content:center; gap:7px; height:36px; padding:0 13px; border:1px solid transparent; border-radius:var(--radius); font-family:var(--font-sans); font-size:13px; line-height:1.3; font-weight:500; white-space:nowrap; cursor:pointer; transition:background-color .14s,border-color .14s; } .ds-button:focus-visible { outline:2px solid var(--ring); outline-offset:3px; }.ds-button { background:var(--primary); color:var(--primary-foreground); border-color:var(--primary); } .ds-button:hover { filter:brightness(.95); } .ds-button:disabled { opacity:.48; cursor:not-allowed; filter:none; } .ds-composer { min-width:0; border:1px solid var(--input); border-radius:var(--radius); overflow:hidden; font-family:var(--font-sans); background:var(--background); } .ds-composer:focus-within { outline:2px solid var(--ring); outline-offset:2px; } .ds-question { box-sizing:border-box; display:block; width:100%; min-height:112px; padding:18px 18px 8px; border:0; border-radius:0; color:var(--foreground); background:var(--background); font-family:var(--font-sans); font-size:15px; line-height:1.6; caret-color:var(--primary); resize:vertical; } .ds-question::placeholder { color:var(--muted-foreground); opacity:1; } .ds-question:focus { outline:none; box-shadow:none; } .ds-composer-addon { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:10px 12px 12px 18px; } .ds-composer-addon > span { color:var(--muted-foreground); font-size:12px; line-height:1.6; } @media(max-width:600px) { .ds-question { font-size:16px; padding:14px; } .ds-composer-addon { flex-wrap:wrap; padding:8px 12px 12px; gap:12px; } .ds-composer-addon > .ds-button { margin-left:auto; } }"
    }
  ],
  "narrative": {
