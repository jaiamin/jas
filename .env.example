OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Provider/model settings can also be saved locally in the app. Saved settings take precedence.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
# JAS_WORKSPACE selects a directory for the installed CLI; --workspace overrides it.
# JAS_WORKSPACE=
JAS_DATABASE_URL=sqlite:///data/jas.sqlite3
JAS_BUDGET_USD=25
JAS_PORT=8080
# Planner model for AI-assisted protocol design.
JAS_PLANNER_MODEL=openai:gpt-6.1-sol
# General and evidence-scoped Assistant answers (no automatic model substitution).
JAS_ASSISTANT_MODEL=openai:gpt-6.1-sol
# Aggregate provider request pool, shared by planner, Assistant and agents (1–32).
JAS_CONCURRENT_REQUESTS=4
# Independent runs only; decisions within a run remain causally ordered (1–16).
JAS_CONCURRENT_RUNS=3

# Comma-separated hostnames/IPs without ports; add the explicit host used by a LAN/proxy URL.
JAS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Set both for password-protected single-user hosting; leave both empty for local use.
# Use HTTPS when exposing the app outside localhost. Enter real passwords only in secrets.
JAS_AUTH_USERNAME=
JAS_AUTH_PASSWORD=
# Require authentication even when an upstream proxy preserves a loopback Host header.
# Non-loopback JAS_ALLOWED_HOSTS also require authentication. The production image defaults to 1.
JAS_REQUIRE_AUTH=0

# Gallery uses the official service by default; browsing needs no account or provider key.
# Optional override for self-hosting/development:
# JAS_GALLERY_URL=https://gallery.example
# Gallery service only (never copy provider keys into that service):
# JAS_GALLERY_ORIGIN=https://gallery.example
# JAS_GALLERY_DATA=/app/gallery-data
# JAS_GITHUB_CLIENT_ID=
# JAS_GITHUB_CLIENT_SECRET=
# JAS_GALLERY_S3_BUCKET=
# JAS_GALLERY_S3_ENDPOINT=
# JAS_GALLERY_S3_REGION=auto
# JAS_GALLERY_S3_ADDRESSING_STYLE=auto
# JAS_GALLERY_S3_ACCESS_KEY_ID=
# JAS_GALLERY_S3_SECRET_ACCESS_KEY=
