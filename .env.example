OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
ASS_DATABASE_URL=sqlite:///data/ass.sqlite3
ASS_BUDGET_USD=25
ASS_PORT=8080
# Optional planner model; GPT-6 Luna can design protocols without native web research.
ASS_PLANNER_MODEL=openai:gpt-6.1-sol
# Independent runs only; decisions within a run remain causally ordered (1–16).
ASS_CONCURRENT_RUNS=3
