OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
JAS_DATABASE_URL=sqlite:///data/jas.sqlite3
JAS_BUDGET_USD=25
JAS_PORT=8080
# Planner model for AI-assisted protocol design.
JAS_PLANNER_MODEL=openai:gpt-6.1-sol
# General and evidence-scoped Agent answers (no automatic model substitution).
JAS_ASSISTANT_MODEL=openai:gpt-6.1-sol
# Aggregate provider request pool, shared by planner, Agent and participants (1–32).
JAS_CONCURRENT_REQUESTS=4
# Independent runs only; decisions within a run remain causally ordered (1–16).
JAS_CONCURRENT_RUNS=3

# Comma-separated hostnames/IPs without ports; add the explicit host used by a LAN/proxy URL.
JAS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
