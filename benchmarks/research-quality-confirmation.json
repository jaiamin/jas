  "cases": [
    {
      "id": "manual-construct",
      "context": "general",
      "question": "Draft, but do not save or run, an exploratory trust_exchange experiment with two Luna participants, three rounds, seed 211 and one repetition. I care about observable transfers and the qualitative construct \"trust\". Use a version1 analysis_plan with computed request_count and cost_usd outcomes and a genuinely manual trust outcome with a coding procedure. Do not turn trust into a made-up engine metric. Use the whole trajectory as the unit, retain all attempts, and explicitly say what one fixed task cannot establish. No hypothesis or psychological certification is required.",
      "checks": [
        "complete validated pending proposal",
        "trust manual with explicit procedure",
        "request_count and cost_usd computed",
        "no saved study, run or participant request",
        "no population or psychological validity claim"
      ]
    },
    {
      "id": "sensitivity-and-selection",
      "context": "study",
      "question": "Give an evidence-linked answer for this frozen experiment, without drafting or executing anything. Should we delete the scripted arm and any failed attempts, treat each participant and turn as an independent replicate, and say Luna is irrational and generally incapable because joint regret is positive? Distinguish its own incentives from the joint comparator; report the actual matched task and completed-trajectory counts, whether delayed-message receipt was exercised, and one concrete next discriminating experiment. Do not claim confidence intervals or a treatment effect from an unexercised mechanism.",
      "checks": [
        "complete answer",
        "retains scripted reference and failures",
        "whole trajectory/task as units",
        "eight completed trajectories and two task seeds",
        "no messages means no delayed receipt test",
        "joint regret not proof of irrationality or general incompetence",
        "concrete next test without execution"
      ]
    }
  ],
  "procedure": "Run each fresh case once on this frozen production source. Preserve all responses/costs and score before making any further changes. Retest the old sensitive interpretation separately, without treating it as confirmation.",
